{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "extends": "nx/presets/npm.json",
    "defaultBase": "master",
    "cli": {
        "packageManager": "npm"
    },
    "workspaceLayout": {
        "libsDir": "packages"
    },
    "parallel": 3,
    "useInferencePlugins": false,
    "release": {
        "projects": ["tag:lib"],
        "version": {
            "git": {
                "stageChanges": true,
                "commit": false,
                "push": false,
                "tag": false
            },
            "currentVersionResolver": "registry",
            "fallbackCurrentVersionResolver": "disk",
            "versionPrefix": "^",
            "manifestRootsToUpdate": ["{projectRoot}"],
            "preserveLocalDependencyProtocols": false,
            "preserveMatchingDependencyRanges": false
        },
        "changelog": {
            "git": {
                "stageChanges": false,
                "commit": false,
                "push": false,
                "tag": false
            },
            "projectChangelogs": false,
            "workspaceChangelog": false
        }
    },
    "plugins": [
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            }
        },
        {
            "plugin": "@nx/rollup/plugin",
            "options": {
                "buildTargetName": "build",
                "buildDepsTargetName": "build-deps",
                "watchDepsTargetName": "watch-deps"
            }
        },
        {
            "plugin": "@nx/vitest",
            "options": {
                "testTargetName": "test",
                "ciTargetName": "test-ci",
                "testMode": "watch"
            }
        }
    ],
    "pluginsConfig": {
        "@nx/js": {
            "analyzeSourceFiles": true
        }
    },
    "generators": {
        "@nx/angular:library": {
            "linter": "eslint",
            "unitTestRunner": "vitest-analog"
        },
        "@nx/angular:component": {
            "style": "css",
            "type": "component"
        },
        "@schematics/angular:component": {
            "type": "component"
        },
        "@nx/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@nx/angular:service": {
            "type": "service"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@nx/angular:scam": {
            "type": "component"
        },
        "@nx/angular:scam-directive": {
            "type": "directive"
        },
        "@nx/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@nx/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@nx/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@nx/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@nx/angular:resolver": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    },
    "namedInputs": {
        "sharedGlobals": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/tsconfig.json"
        ],
        "default": [
            "sharedGlobals",
            "{projectRoot}/src/**/*.ts",
            "{projectRoot}/project.json",
            "{projectRoot}/tsconfig.json",
            "{projectRoot}/tsconfig.app.json",
            "{projectRoot}/tsconfig.lib.json"
        ],
        "building": [
            "default",
            "!{projectRoot}/src/**/*.spec.ts"
        ],
        "production": [
            "building",
            "{projectRoot}/package.json",
            "{projectRoot}/ng-package.json",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/src/test-setup.[jt]s",
            "!{projectRoot}/vitest.config(ci)?.[jt]s",
            "!{projectRoot}/vite.config(ci)?.[jt]s"
        ],
        "linting": [
            "{workspaceRoot}/eslint.config.mjs"
        ],
        "vitestTests": [
            "{projectRoot}/**/*.spec.ts",
            "{projectRoot}/tsconfig.spec.json",
            "{projectRoot}/vitest.config.ci.(m)?[tj]s",
            "{projectRoot}/vitest.config.(m)?[tj]s",
            "{workspaceRoot}/vitest.project.ts",
            "{workspaceRoot}/vitest.workspace.ts"
        ]
    },
    "targetDefaults": {
        "test": [
            {
                "filter": {
                    "plugin": "@nx/vitest"
                },
                "inputs": [
                    "default",
                    "vitestTests",
                    "^production"
                ],
                "outputs": [
                    "{workspaceRoot}/.reports/{projectRoot}/VITEST-report.xml",
                    "{workspaceRoot}/coverage/{projectRoot}"
                ],
                "cache": true,
                "options": {
                    "watch": false
                },
                "configurations": {
                    "watch": {
                        "mode": "watch"
                    },
                    "ci": {
                        "mode": "ci"
                    }
                }
            },
            {
                "filter": {
                    "executor": "@nx/angular:unit-test"
                },
                "inputs": [
                    "default",
                    "vitestTests",
                    "^production"
                ],
                "outputs": [
                    "{workspaceRoot}/.reports/{projectRoot}/VITEST-report.xml",
                    "{workspaceRoot}/coverage/{projectRoot}"
                ],
                "cache": true,
                "options": {
                    "watch": false
                },
                "configurations": {
                    "watch": {
                        "watch": true
                    },
                    "ci": {
                        "runnerConfig": "{projectRoot}/vite.config.ci.mts"
                    }
                }
            }
        ],
        "@nx/eslint:lint": {
            "cache": true,
            "inputs": [
                "default",
                "^default",
                "linting",
                "{workspaceRoot}/tools/eslint-rules/**/*"
            ],
            "options": {
                "fix": true
            }
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"],
            "cache": true
        },
        "@nx/angular:ng-packagr-lite": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "@nx/js:tsc": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "@nx/rollup:rollup": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "nx-release-publish": {
            "options": {
                "packageRoot": "dist/{projectName}"
            }
        },
        "@nx/vitest:test": {
            "cache": true,
            "inputs": [
                "default",
                "^production"
            ]
        }
    },
    "analytics": false,
    "neverConnectToCloud": true
}
