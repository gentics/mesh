<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gentics.mesh.contentrag</groupId>
        <artifactId>mesh-content-rag-parent</artifactId>
        <version>3.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>mesh-content-rag-mesh-sync</artifactId>
    <name>Gentics Mesh Content RAG (Mesh-Sync)</name>
    <description>
        Mesh-seitiger Teil des RAG-Syncs: Feldauswahl je Schema (Allow-List), Auswertung der
        No-RAG-Konvention (K4) und das Einsammeln der normalisierten Feldtexte. Noch ohne
        Abhaengigkeit auf mesh-elasticsearch und mesh-mdm-api: die Auswahlregeln sind der
        inhaltlich kniffligste Teil und sollen ohne laufendes Mesh testbar bleiben. Der Adapter
        auf die Mesh-Schema-API und die beiden Handler kommen mit der Anbindung an den Sync dazu
        (siehe MESH-INDEX-HANDLER.md).
    </description>

    <dependencies>
        <dependency>
            <groupId>com.gentics.mesh.contentrag</groupId>
            <artifactId>mesh-content-rag-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.mesh.contentrag</groupId>
            <artifactId>mesh-content-rag-chunking</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.mesh.contentrag</groupId>
            <artifactId>mesh-content-rag-index-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
