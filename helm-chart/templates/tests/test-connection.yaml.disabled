apiVersion: v1
kind: Pod
metadata:
  name: "{{ include "mesh.fullname" . }}-test-connection"
  labels:
{{ include "mesh.labels" . | nindent 4 }}
  annotations:
    "helm.sh/hook": test-success
spec:
  containers:
    - name: wget
      image: busybox
      command: ['wget']
      args:  ['{{ include "mesh.fullname" . }}:{{ .Values.service.mesh.port }}']
  restartPolicy: Never
