<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.gentics.mesh.plugin</groupId>
    <artifactId>mesh-must-read-plugin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <verbose>true</verbose>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer>
                                    <manifestEntries>
                                        <Plugin-Id>${plugin.id}</Plugin-Id>
                                        <Plugin-Name>${plugin.name}</Plugin-Name>
                                        <Plugin-Version>${plugin.version}</Plugin-Version>
                                        <Plugin-Author>${plugin.author}</Plugin-Author>
                                        <Plugin-Class>${plugin.class}</Plugin-Class>
                                        <Plugin-Description>${plugin.description}</Plugin-Description>
                                        <Plugin-License>${plugin.license}</Plugin-License>
                                        <Plugin-Inception>${plugin.inception}</Plugin-Inception>
                                        <Main-Verticle>service:com.gentics.mesh.plugin.plugin-service</Main-Verticle>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <releases/>
            <id>maven.gentics.com</id>
            <name>Gentics Maven Repository</name>
            <url>https://maven.gentics.com/maven2</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>com.gentics.mesh</groupId>
            <artifactId>mesh-plugin-dep</artifactId>
            <version>0.39.2</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <artifactId>mesh-plugin-api</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <artifactId>hamcrest-core</artifactId>
                    <groupId>org.hamcrest</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.gentics.mesh</groupId>
            <artifactId>mesh-test-common</artifactId>
            <version>0.39.2</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <artifactId>mesh-common</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>vertx-unit</artifactId>
                    <groupId>io.vertx</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>assertj-core</artifactId>
                    <groupId>org.assertj</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>simple-xml</artifactId>
                    <groupId>org.simpleframework</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>jsonassert</artifactId>
                    <groupId>org.skyscreamer</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mockito-all</artifactId>
                    <groupId>org.mockito</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>json-path</artifactId>
                    <groupId>com.jayway.jsonpath</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>testcontainers</artifactId>
                    <groupId>org.testcontainers</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>toxiproxy</artifactId>
                    <groupId>org.testcontainers</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>jdom</artifactId>
                    <groupId>org.jdom</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.gentics.mesh</groupId>
            <artifactId>mesh-core</artifactId>
            <version>0.39.2</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <artifactId>mesh-orientdb</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-distributed</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-elasticsearch</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-graphql</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>commons-lang3</artifactId>
                    <groupId>org.apache.commons</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>commons-csv</artifactId>
                    <groupId>org.apache.commons</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-service-local-storage</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-service-image-imgscalr</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-service-keycloak-auth</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>tika-parsers</artifactId>
                    <groupId>org.apache.tika</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-service-metrics-prometheus</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-changelog-system</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>vertx-hazelcast</artifactId>
                    <groupId>io.vertx</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>hazelcast</artifactId>
                    <groupId>com.hazelcast</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>hazelcast-kubernetes</artifactId>
                    <groupId>com.hazelcast</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>vertx-mail-client</artifactId>
                    <groupId>io.vertx</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>vertx-web</artifactId>
                    <groupId>io.vertx</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>dagger</artifactId>
                    <groupId>com.google.dagger</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>joda-time</artifactId>
                    <groupId>joda-time</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mesh-common</artifactId>
                    <groupId>com.gentics.mesh</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>mockito-all</artifactId>
                    <groupId>org.mockito</groupId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.gentics.mesh</groupId>
                <artifactId>mesh-plugin-bom</artifactId>
                <version>${mesh.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <properties>
        <plugin.id>must-read</plugin.id>
        <plugin.inception>2019-08-30</plugin.inception>
        <mesh.version>0.39.2</mesh.version>
        <plugin.author>Gentics</plugin.author>
        <plugin.description>Plugin to handle reading of must-read nodes</plugin.description>
        <plugin.class>com.gentics.mesh.plugin.mustReadPlugin</plugin.class>
        <plugin.license>Commercial</plugin.license>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <plugin.version>1.0.0-SNAPSHOT</plugin.version>
        <plugin.name>Must Read Plugin</plugin.name>
    </properties>
</project>
