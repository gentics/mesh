<div class="mdc-form-field">
    <legend>{{label}}</legend>
    {{zaehlerpunkt}}
  <div data-mdc-auto-init="Textfield" class="mdc-textfield mdc-textfield--box mdc-textfield--hidden-label mdc-textfield-fixed-size mdc-textfield-fixed-size--medium " element-name="{{ name }}">
    <div class="content form-group">
      <input type="text" id="{{ name }}" class="mdc-textfield__input"
        {{#if minVal }}min="{{ minVal }}" minval="{{ minVal }}"{{/if}}
        {{#if maxVal }}max="{{ maxVal }}" maxval="{{ maxVal }}"{{/if}}
        {{#if maxCharCount }}maxlength="{{ maxCharCount }}" maxcharcount="{{ maxCharCount }}"{{/if}}
        name="{{ name }}" placeholdername=""
        value="{{#if data.value }}{{ getZaehlerstandValue data.value zaehlerpunkt }}{{else}}{{ value }}{{/if}}"
        aria-label="{{{label}}}"
        {{#if mandatory}}required="required"{{/if}}>
    </div>
  </div>
</div>
