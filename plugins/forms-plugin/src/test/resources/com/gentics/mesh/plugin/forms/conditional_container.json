{
	"name": "Form with Conditional Container",
	"type": "GENERIC",
	"adminEmailAddress": "test@green.mail",
	"adminEmailSubject": "testmail",
	"adminEmailTemplate": "testmail",
	"cms_id": 1,
	"schema": {
		"key": "test-schema",
	    "version": "1.0.0",
	    "properties": {
