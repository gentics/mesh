					{
						"type": "binary",
						"name": "conditional_file",
						"label": "Conditional file",
						"mandatory": true
					},
					{
						"type": "mandatorygroup",
						"name": "mandatory_group",
						"label": "Conditional group",
						"elements": [
							{
								"type": "string",
								"name": "mandatory_group_input",
								"label": "Mandatory group input"
