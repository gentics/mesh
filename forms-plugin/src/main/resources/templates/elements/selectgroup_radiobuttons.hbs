<div>
	<fieldset>
		<legend>{{{ label }}}</legend>
{{#each options }}
			<input type="radio" id="{{ name }}-{{ @index }}" name="{{ name }}"
				value="{{ key }}"
				{{#if mandatory}}required="required"{{/if}}
				{{#equals key data.value}}checked="checked"{{/equals}}>
			<label for="{{ name }}-{{ @index }}">{{{ value }}}</label>
{{/each}}
{{#if additional_element }}
			<input type="radio" id="{{ name }}-additional" name="{{ name }}"
				value="{{ name }}additional_field" class="mdc-radio__native-control"
				{{#if mandatory}}required="required"{{/if}}
				{{#equals name data.value}}checked="checked"{{/equals}}>
			<input type="text" class="mdc-textfield__input"
				name="{{ name }}_additional" placeholdername=""
				value="{{#if data.value }}{{ data.value }}{{else}}{{ value }}{{/if}}">
{{/if}}
		</fieldset>
</div>