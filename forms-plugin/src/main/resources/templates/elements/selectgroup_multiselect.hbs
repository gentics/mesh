<div>
	<select name="{{ name }}[]" {{#if mandatory}}required="required"{{/if}} multiple>
{{#each options }}
		<option value="{{ key }}" {{#equals key data.value}}selected="selected"{{/equals}}>{{{ value }}}</option>
{{/each}}
{{#if additional_element }}
		<option value="{{ name }}additional_field"{{#if data.additional_element }} selected="selected"{{/if}}>Additional element</option>
{{/if}}
	</select>
	<label for="{{ name }}">{{{ label }}}</label>
{{#if additional_element }}
	<input type="text" class="mdc-textfield__input"
		name="{{ name }}_additional" placeholdername=""
		value="{{#if data.additional_element }}{{ data.additional_element }}{{else}}{{ value }}{{/if}}">
{{/if}}
</div>
