<div>
	<select name="{{ name }}" {{#if mandatory}}required="required"{{/if}}>
{{#each options }}
		<option value="{{ key }}" {{#equals key data.value}}selected="selected"{{/equals}}>{{{ value }}}</option>
{{/each}}
	</select>
	<label for="{{ name }}">{{{ label }}}</label>
{{#if additional_element }}
	<input type="text" class="mdc-textfield__input"
		name="{{ name }}_additional" placeholdername=""
		value="{{#if data.value }}{{ data.value }}{{else}}{{ value }}{{/if}}">
{{/if}}
</div>