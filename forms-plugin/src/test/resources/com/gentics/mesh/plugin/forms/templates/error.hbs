{{#if data.error }}
<section class="c-form__message">
	<div class="c-message c-message--error">
		<h2 class="c-message__title o-heading-2--highlight">
			{{ data.error.title }}
			<svg class="c-message__icon" role="img" aria-hidden="true">
				<use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#warning"></use>
			</svg>
		</h2>
		<p class="c-message__text">{{ data.error.message }}</p>
	</div>
</section>
{{/if}}