<div class="element-dropdown" element-name="{{ name }}">
	<div class="content">
		<div class="c-input-with-tooltip" id="tooltip-67">
			<select class="mdc-select" data-mdc-auto-init="Select"
				name="{{ name }}" placeholdername="" {{#if mandatory}}required="required"{{/if}}>
				<option value="">{{ label }}</option>
{{#each options }}
				<option value="{{ value }}" {{#equals value data.value}}selected="selected"{{/equals}}>{{{ label }}}</option>
{{/each}}
			</select>
		</div>
	</div>
</div>
