<div class="mdc-form-field">
	<div class="c-input-file{{#if data.value }} has-file{{/if}}" data-mdc-auto-init="File">
		<input type="file" id="{{ name }}" name="{{ name }}" class="c-input-file__input">
		<span class="c-input-file__description">{{#if data.value }}{{ data.value }}{{else}}Keine Datei ausgewählt{{/if}}</span>
		<label class="c-input-file__action" for="{{ name }}">Datei auswählen</label>
		<label class="c-input-file__label" for="{{ name }}">{{{ label }}}</label>
	</div>
</div>
