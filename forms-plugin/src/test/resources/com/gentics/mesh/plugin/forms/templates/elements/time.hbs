<div class="mdc-textfield mdc-textfield--box mdc-textfield--with-trailing-icon" data-mdc-auto-init="DateTime" data-type="time" data-future="true" element-name="{{ name }}">
  <div class="content form-group">
    <input type="text" id="{{ name }}" class="mdc-textfield__input" name="{{ name }}" placeholdername=""
      value="{{#if data.value }}{{ data.value }}{{else}}{{ value }}{{/if}}"
      {{#if mandatory}}required="required"{{/if}}>
    <label for="{{ name }}" class="control-label mdc-textfield__label">{{{ label }}}</label>
    <svg class="mdc-textfield__icon" role="img" aria-hidden="true">
      <use xlink:href="#clock3"></use>
    </svg>
  </div>
</div>