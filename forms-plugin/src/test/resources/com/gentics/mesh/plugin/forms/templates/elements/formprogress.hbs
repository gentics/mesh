<div class="element-formprogress floating-label">
	<div class="content form-group">
		<section class="c-form__progress">
			<ol class="c-form-progress" data-mdc-auto-init="Progress"
				role="progressbar" aria-valuetext="Beschreibung der ersten Seite"
				aria-valuemin="1" aria-valuenow="1" aria-valuemax="2">
{{#each ../elements}}
{{#equals type "formpage" }}
				<li class="c-form-progress__step {{ class }}" id="step_{{ name }}"><div
						class="c-form-progress__step-title">
						<a class="c-form-progress__step-link" href="#!"
							data-formpageid="{{ name }}">{{{ label }}}</a>
					</div>
					<div class="c-form-progress__step-description">{{ info }}</div></li>
{{/equals}}
{{/each}}
			</ol>
		</section>
	</div>
</div>