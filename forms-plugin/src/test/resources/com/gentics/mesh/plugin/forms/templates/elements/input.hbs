Input
	name: {{ name }}
	label: {{ label }}
	type: {{formsInputType this}}
	minVal: {{ minVal }}
	maxVal: {{ maxVal }}
	maxCharCount: {{ maxCharCount }}
	value: {{#if data.value }}{{ data.value }}{{else}}{{ value }}{{/if}}
	properties.textkey: {{ properties.textkey }}
	properties.intkey: {{ properties.intkey }}
	properties.booleankey: {{ properties.booleankey }}
	properties.arraykey: {{{ properties.arraykey }}}
	properties.objectkey.key: {{ properties.objectkey.key }}
