<div class="element-buttons floating-label"	element-name="{{ name }}">
	<div class="content sendbar">
		<section class="c-form__actions">
			<button type="submit" name="submitb" value="{{#if submitlabel }}{{ submitlabel }}{{else}}Abschicken{{/if}}"
				class="btn btn-primary">{{#if submitlabel }}{{ submitlabel }}{{else}}Abschicken{{/if}}</button>
{{#if showreset}}
			<button type="reset" name="resetb" value="{{#if resetlabel}}{{ resetlabel }}{{else}}Zurücksetzen{{/if}}" class="btn btn-form-grey">{{#if resetlabel}}{{ resetlabel }}{{else}}Zurücksetzen{{/if}}</button>
{{/if}}
		</section>
	</div>
</div>
