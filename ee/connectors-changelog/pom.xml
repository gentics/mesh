<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gentics.mesh.enterprise</groupId>
		<artifactId>mesh-enterprise</artifactId>
		<version>3.3.3-SNAPSHOT</version>
	</parent>

	<name>Gentics Mesh Enterprise - Database connectors changelog</name>
	<artifactId>mesh-enterprise-connectors-changelog</artifactId>
	<packaging>pom</packaging>
	<description>Module for management of connector changelog entries.</description>

	<properties>
		<changelog.version>${project.version}</changelog.version>
	</properties>

	<!-- get mesh changelog entries as dependencies, merge with own changelog entries and assemble those -->
	<build>
		<plugins>
			<!-- Copy Mesh SQL Changelog entries to target directory -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-resources</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/changelog/entries</outputDirectory>
							<resources>          
								<resource>
									<directory>src/changelog/entries</directory>
									<filtering>false</filtering>
								</resource>
							</resources>              
						</configuration>            
					</execution>
				</executions>
			</plugin>
			<!-- Assemble combined changelog entries -->
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>entries</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<attach>true</attach>
							<appendAssemblyId>true</appendAssemblyId>
							<descriptors>
								<descriptor>${project.basedir}/src/assembly/changelog-entries.xml</descriptor>
							</descriptors>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- When installing, we copy the generated changelog file to the root directory -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.basedir}/../</outputDirectory>
							<resources>          
								<resource>
									<directory>${project.build.directory}/output</directory>
									<includes>
										<include>changelog-3.adoc-include</include>
									</includes>
									<filtering>false</filtering>
								</resource>
							</resources>              
						</configuration>            
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
