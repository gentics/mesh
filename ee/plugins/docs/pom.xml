<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>mesh-enterprise-plugins-guides</artifactId>
	<packaging>pom</packaging>

    <parent>
        <groupId>com.gentics.mesh.plugin.enterprise</groupId>
		<artifactId>mesh-enterprise-plugins</artifactId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>

	<organization>
		<name>Gentics Software GmbH</name>
		<url>http://www.gentics.com/</url>
	</organization>

	<!-- These force the reactor to build each plugin (and its generated openapi.yaml, see
	     PluginOpenApiGeneratorRunner) before this module, and let maven-dependency-plugin
	     below unpack the spec out of the plugin's jar. -->
	<dependencies>
		<dependency>
			<groupId>com.gentics.mesh.plugin.enterprise</groupId>
			<artifactId>mesh-favorite-plugin</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.enterprise</groupId>
			<artifactId>mesh-search-plugin</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>unpack-openapi-specs</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.enterprise</groupId>
									<artifactId>mesh-favorite-plugin</artifactId>
									<includes>META-INF/openapi/openapi.yaml</includes>
									<outputDirectory>${project.build.directory}/openapi/favorite-plugin</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.enterprise</groupId>
									<artifactId>mesh-search-plugin</artifactId>
									<includes>META-INF/openapi/openapi.yaml</includes>
									<outputDirectory>${project.build.directory}/openapi/search-plugin</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>entries</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<attach>true</attach>
							<appendAssemblyId>true</appendAssemblyId>
							<descriptors>
								<descriptor>${project.basedir}/assembly/guides.xml</descriptor>
							</descriptors>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
