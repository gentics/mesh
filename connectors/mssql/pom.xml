<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gentics.mesh.enterprise</groupId>
		<artifactId>mesh-enterprise-database-connectors</artifactId>
		<version>3.0.10-SNAPSHOT</version>
	</parent>

	<artifactId>mesh-enterprise-database-connector-mssql</artifactId>
	<packaging>jar</packaging>

	<name>Gentics Mesh Enterprise - Microsoft SQL Server connector</name>

	<dependencies>
		<dependency>
			<groupId>com.gentics.mesh.enterprise</groupId>
			<artifactId>mesh-enterprise-database-connector-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<version>10.2.0.jre17</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>mesh-mdm-hibernate-core</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>mesh-database-tests-common</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>tests-mesh-hibernate</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.enterprise</groupId>
			<artifactId>mesh-enterprise-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/connector.build.properties</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<includes>
					<include>**/*</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>0-unpack-test-resources</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.gentics.mesh.enterprise</groupId>
									<artifactId>mesh-enterprise-database-connector-common</artifactId>
									<!-- https://issues.apache.org/jira/browse/MDEP-732 -->
									<!-- <type>test-jar</type> -->
									<classifier>tests</classifier>
									<outputDirectory>${project.build.directory}/test-classes</outputDirectory>
									<includes>**/*</includes>
									<overWrite>true</overWrite>
								</artifactItem>
								
							</artifactItems>
						</configuration>
					</execution>
					<execution>
						<?m2e ignore?>
						<id>1-copy-sharedlib-dependencies-no-mesh</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<excludeScope>test</excludeScope>
							<includeScope>runtime</includeScope>
							<excludeGroupIds>com.gentics.mesh</excludeGroupIds>
							<outputDirectory>${project.build.directory}/mavendependencies-sharedlibs</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<?m2e ignore?>
						<id>2-copy-sharedlib-dependencies-with-mesh-database-common</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<excludeScope>test</excludeScope>
							<includeScope>runtime</includeScope>
							<includeGroupIds>com.gentics.mesh</includeGroupIds>
							<includeArtifactIds>mesh-database-connector-common</includeArtifactIds>
							<outputDirectory>${project.build.directory}/mavendependencies-sharedlibs</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<id>1-shade-none-but-mesh-core-and-driver</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							</transformers>
							<artifactSet>
							<!-- Keep in sync with mesh-bom/pom.xml! -->
								<excludes>
									<exclude>com.gentics.mesh:*</exclude>
									<exclude>org.hibernate.*:*</exclude>
									<exclude>org.slf4j:*</exclude>
									<exclude>org.apache.*:*</exclude>
									<exclude>ch.qos.logback:*</exclude>
									<exclude>com.google.dagger:*</exclude>
									<exclude>commons-*:*</exclude>
									<exclude>com.squareup.okhttp3:*</exclude>
									<exclude>org.bouncycastle:*</exclude>
									<exclude>software.amazon.awssdk:*</exclude>
									<exclude>org.raml:*</exclude>
									<exclude>com.google.*:*</exclude>
									<exclude>org.springframework.security:*</exclude>
									<exclude>com.fasterxml.*:*</exclude>
									<exclude>com.hazelcast:*</exclude>
									<exclude>io.vertx:*</exclude>
									<exclude>io.reactivex:*</exclude>
									<exclude>io.micrometer:*</exclude>
									<exclude>com.github.*:*</exclude>
									<exclude>io.netty:*</exclude>
									<exclude>net.lingala.zip4j:*</exclude>
									<exclude>com.gentics.elasticsearch:*</exclude>
									<exclude>org.jsoup:*</exclude>
									<exclude>com.graphql-java:*</exclude>
									<exclude>com.gentics.graphqlfilter:*</exclude>
									<exclude>org.openjdk.nashorn:*</exclude>
									<exclude>com.sksamuel.scrimage:*</exclude>
									<exclude>com.zaxxer:*</exclude>
									<exclude>jakarta.*:*</exclude>
									<exclude>com.squareup.inject:*</exclude>
									<exclude>org.hibernate:*</exclude>
									<exclude>org.liquibase:*</exclude>
									<exclude>org.ehcache:*</exclude>
									<exclude>net.bytebuddy:*</exclude>
									<exclude>javax.*:*</exclude>
									<exclude>net.sf.jopt-simple:*</exclude>
									<exclude>org.hdrhistogram:*</exclude>
									<exclude>org.latencyutils:*</exclude>
									<exclude>org.antlr:*</exclude>
									<exclude>org.assertj:*</exclude>
									<exclude>org.checkerframework:*</exclude>
									<exclude>org.codehaus.jettison:*</exclude>
									<exclude>org.glassfish.jaxb:*</exclude>
									<exclude>org.codehaus.jettison:*</exclude>
									<exclude>org.jboss:*</exclude>
									<exclude>joda-time:*</exclude>
									<exclude>org.mozilla:*</exclude>
									<exclude>org.reactivestreams:*</exclude>
									<exclude>org.yaml:snakeyaml</exclude>
									<exclude>org.codehaus.jettison:*</exclude>
								</excludes>
							</artifactSet>
						</configuration>
					</execution>
					<execution>
						<id>2-shade-none-but-mesh-database-common</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							</transformers>
							<artifactSet>
								<includes>
									<!-- Deps from mesh-enterprise-database-connector-common -->
									<include>com.gentics.mesh:mesh-database-connector-common</include>
									<!-- Deps from license-checker -->
									<include>commons-io:commons-io</include>
									<include>commons-httpclient:commons-httpclient</include>
									<include>org.apache.httpcomponents:httpclient</include>
									<include>javax.servlet:servlet-api</include>
								</includes>
							</artifactSet>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<dependenciesToScan>
						<dependency>com.gentics.mesh:tests-mesh-api</dependency>
						<dependency>com.gentics.mesh:tests-mesh-core</dependency>
						<dependency>com.gentics.mesh:tests-mesh-rest-model</dependency>
						<dependency>com.gentics.mesh:tests-mesh-rest-client</dependency>
						<dependency>com.gentics.mesh:tests-mesh-plugin-api</dependency>
						<dependency>com.gentics.mesh:tests-mesh-server</dependency>
						<dependency>com.gentics.mesh:tests-mesh-changelog-system</dependency>
						<dependency>com.gentics.mesh:tests-mesh-elasticsearch</dependency>
						<dependency>com.gentics.mesh:tests-mesh-distributed</dependency>
						<dependency>com.gentics.mesh:tests-mesh-distributed-coordinator</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-aws-s3-storage</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-image-imgscalr</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-jwt-auth</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-local-storage</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-metrics-prometheus</dependency>
						<dependency>com.gentics.mesh:tests-mesh-hibernate</dependency>
						<dependency>com.gentics.mesh:mesh-database-tests-common</dependency>
					</dependenciesToScan>
					<skip>${skip.mssql.tests}</skip>
					<jvm>${env.JAVA_HOME}/bin/java</jvm>
					<argLine>-Xms128m -Xmx512m
						--add-opens=java.base/java.util=ALL-UNNAMED
						${jacoco.env}
					</argLine>
					<forkedProcessTimeoutInSeconds>2700</forkedProcessTimeoutInSeconds>
					<rerunFailingTestsCount>0</rerunFailingTestsCount>
					<reuseForks>false</reuseForks>
					<forkCount>${surefire.forkcount}</forkCount>
					<trimStackTrace>false</trimStackTrace>
					<useSystemClassLoader>false</useSystemClassLoader>
					<excludes>
						<include>**/*AbstractTest.java</include>
						<include>**/*Abstract*Test.java</include>
						<exclude>**/*Abstract*.java</exclude>
						<exclude>**/Abstract*.java</exclude>
					</excludes>
					<groups>${surefire.groups}</groups>
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
					<reportNameSuffix>mssql</reportNameSuffix>
					<systemPropertyVariables>
						<mesh.testdb.manager.host>${mesh.testdb.manager.host}</mesh.testdb.manager.host>
						<mesh.testdb.manager.port>${mesh.testdb.manager.port}</mesh.testdb.manager.port>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<!-- Plugin for managing docker containers for the mesh-testdb-manager -->
			<plugin>
				<groupId>io.fabric8</groupId>
				<artifactId>docker-maven-plugin</artifactId>
				<extensions>true</extensions>
				<configuration>
					<showLogs>mssql,testdb-manager</showLogs>
					<images>
						<image>
							<alias>mssql</alias>
							<name>mcr.microsoft.com/mssql/server:2019-latest</name>
							<run>
								<skip>${skip.mssql.tests}</skip>
								<env>
									<ACCEPT_EULA>Y</ACCEPT_EULA>
									<SA_PASSWORD><![CDATA[changeitNow4567&]]></SA_PASSWORD>
								</env>
								<wait>
									<log>.*SQL Server is now ready for client connections.*</log>
									<time>120000</time>
								</wait>
								<ports>
									<port>mssql.port:1433</port>
								</ports>
							</run>
						</image>
						<!-- See https://git.gentics.com/psc/mesh/mesh-testdb-manager -->
						<image>
							<alias>testdb-manager</alias>
							<name>docker.gentics.com/apps/mesh-testdb-manager:latest</name>
							<run>
								<env>
									<MESH_TESTDB_MANAGER_PORT>8080</MESH_TESTDB_MANAGER_PORT>
									<MESH_TESTDB_MANAGER_POOL_SIZE>10</MESH_TESTDB_MANAGER_POOL_SIZE>
									<MESH_TESTDB_MANAGER_THREADS>1</MESH_TESTDB_MANAGER_THREADS>
									<MESH_TESTDB_MANAGER_NAME_PREFIX>mesh_test_</MESH_TESTDB_MANAGER_NAME_PREFIX>
									<MESH_TESTDB_MANAGER_NAME_LENGTH>10</MESH_TESTDB_MANAGER_NAME_LENGTH>

									<MESH_TESTDB_MANAGER_MSSQL_SKIPPED>${skip.mssql.tests}</MESH_TESTDB_MANAGER_MSSQL_SKIPPED>
									<MESH_TESTDB_MANAGER_MSSQL_HOST>+${docker.container.mssql.ip}</MESH_TESTDB_MANAGER_MSSQL_HOST>
									<MESH_TESTDB_MANAGER_MSSQL_PORT>1433</MESH_TESTDB_MANAGER_MSSQL_PORT>
									<MESH_TESTDB_MANAGER_MSSQL_HOST_EXTERNAL>localhost</MESH_TESTDB_MANAGER_MSSQL_HOST_EXTERNAL>
									<MESH_TESTDB_MANAGER_MSSQL_PORT_EXTERNAL>+${mssql.port}</MESH_TESTDB_MANAGER_MSSQL_PORT_EXTERNAL>
									<MESH_TESTDB_MANAGER_MSSQL_PASSWORD><![CDATA[changeitNow4567&]]></MESH_TESTDB_MANAGER_MSSQL_PASSWORD>

									<MESH_TESTDB_MANAGER_MARIADB_ENABLED>false</MESH_TESTDB_MANAGER_MARIADB_ENABLED>
									<MESH_TESTDB_MANAGER_POSTGRES_ENABLED>false</MESH_TESTDB_MANAGER_POSTGRES_ENABLED>
									<MESH_TESTDB_MANAGER_ORACLE_ENABLED>false</MESH_TESTDB_MANAGER_ORACLE_ENABLED>
								</env>
								<wait>
									<log>.*WebSocket ready for connections.*</log>
									<time>60000</time>
								</wait>
								<ports>
									<port>8080:8080</port>
								</ports>
							</run>
						</image>
					</images>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
