<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

    <parent>
		<groupId>com.gentics.mesh.enterprise</groupId>
		<artifactId>mesh-enterprise-database-connectors</artifactId>
		<version>3.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>mesh-enterprise-database-connector-postgres</artifactId>
	<packaging>jar</packaging>

	<name>Gentics Mesh Enterprise - PostgreSQL connector</name>

	<dependencies>
		<dependency>
			<groupId>com.gentics.mesh.enterprise</groupId>
			<artifactId>mesh-enterprise-database-connector-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.3.3</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics</groupId>
			<artifactId>license-checker</artifactId>
			<version>${license.checker.version}</version>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>mesh-mdm-hibernate-core</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>mesh-database-tests-common</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>tests-mesh-hibernate</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<?m2e ignore?>
						<id>copy-sharedlib-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<excludeScope>test</excludeScope>
							<includeScope>runtime</includeScope>
							<excludeGroupIds>com.gentics.mesh</excludeGroupIds>
							<outputDirectory>${project.build.directory}/mavendependencies-sharedlibs</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
			                    <filter>
			                        <artifact>*:*</artifact>
			                        <excludes>
			                            <exclude>META-INF/*.SF</exclude>
			                            <exclude>META-INF/*.DSA</exclude>
			                            <exclude>META-INF/*.RSA</exclude>
			                        </excludes>
			                    </filter>
			                </filters>
			                <transformers>
				                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
			                </transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<dependenciesToScan>
						<dependency>com.gentics.mesh:tests-mesh-api</dependency>
						<dependency>com.gentics.mesh:tests-mesh-core</dependency>
						<dependency>com.gentics.mesh:tests-mesh-rest-model</dependency>
						<dependency>com.gentics.mesh:tests-mesh-rest-client</dependency>
						<dependency>com.gentics.mesh:tests-mesh-plugin-api</dependency>
						<dependency>com.gentics.mesh:tests-mesh-server</dependency>
						<dependency>com.gentics.mesh:tests-mesh-changelog-system</dependency>
						<dependency>com.gentics.mesh:tests-mesh-elasticsearch</dependency>
						<dependency>com.gentics.mesh:tests-mesh-distributed</dependency>
						<dependency>com.gentics.mesh:tests-mesh-distributed-coordinator</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-aws-s3-storage</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-image-imgscalr</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-jwt-auth</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-local-storage</dependency>
						<dependency>com.gentics.mesh:tests-mesh-service-metrics-prometheus</dependency>
						<dependency>com.gentics.mesh:tests-mesh-hibernate</dependency>
						<dependency>com.gentics.mesh:mesh-database-tests-common</dependency>
					</dependenciesToScan>
					<skip>${skip.postgres.tests}</skip>
					<jvm>${env.JAVA_HOME}/bin/java</jvm>
					<argLine>-Xms128m -Xmx256m -XX:MaxDirectMemorySize=128m
						--add-opens=java.base/java.util=ALL-UNNAMED
						${jacoco.env}
					</argLine>
					<forkedProcessTimeoutInSeconds>2700</forkedProcessTimeoutInSeconds>
					<rerunFailingTestsCount>0</rerunFailingTestsCount>
					<reuseForks>false</reuseForks>
					<forkCount>${surefire.forkcount}</forkCount>
					<trimStackTrace>false</trimStackTrace>
					<useSystemClassLoader>false</useSystemClassLoader>
					<excludes>
						<include>**/*AbstractTest.java</include>
						<include>**/*Abstract*Test.java</include>
						<exclude>**/*Abstract*.java</exclude>
						<exclude>**/Abstract*.java</exclude>
					</excludes>
					<groups>${surefire.groups}</groups>
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
					<reportNameSuffix>postgres</reportNameSuffix>
					<systemPropertyVariables>
						<mesh.testdb.manager.host>${mesh.testdb.manager.host}</mesh.testdb.manager.host>
						<mesh.testdb.manager.port>${mesh.testdb.manager.port}</mesh.testdb.manager.port>
					</systemPropertyVariables>
				</configuration>
			</plugin>
            <!-- Plugin for managing docker containers for the mesh-testdb-manager -->
			<plugin>
				<groupId>io.fabric8</groupId>
				<artifactId>docker-maven-plugin</artifactId>
				<extensions>true</extensions>
				<configuration>
					<showLogs>postgres,testdb-manager</showLogs>
					<images>
						<image>
							<alias>postgres</alias>
							<name>postgres:latest</name>
							<run>
								<skip>${skip.postgres.tests}</skip>
								<env>
									<POSTGRES_DB>mesh</POSTGRES_DB>
									<POSTGRES_USER>meshdbuser</POSTGRES_USER>
									<POSTGRES_PASSWORD><![CDATA[changeitNow4567&]]></POSTGRES_PASSWORD>
								</env>
								<wait>
									<log>database system is ready to accept connections</log>
									<time>120000</time>
								</wait>
								<ports>
									<port>postgres.port:5432</port>
								</ports>
							</run>
						</image>
						<!-- See https://git.gentics.com/psc/mesh/mesh-testdb-manager -->
						<image>
							<alias>testdb-manager</alias>
							<name>docker.apa-it.at/gentics/apps/mesh-testdb-manager:latest</name>
							<run>
								<env>
									<MESH_TESTDB_MANAGER_PORT>8080</MESH_TESTDB_MANAGER_PORT>
									<MESH_TESTDB_MANAGER_POOL_SIZE>10</MESH_TESTDB_MANAGER_POOL_SIZE>
									<MESH_TESTDB_MANAGER_THREADS>1</MESH_TESTDB_MANAGER_THREADS>
									<MESH_TESTDB_MANAGER_NAME_PREFIX>mesh_test_</MESH_TESTDB_MANAGER_NAME_PREFIX>
									<MESH_TESTDB_MANAGER_NAME_LENGTH>10</MESH_TESTDB_MANAGER_NAME_LENGTH>

									<MESH_TESTDB_MANAGER_POSTGRES_SKIPPED>${skip.postgres.tests}</MESH_TESTDB_MANAGER_POSTGRES_SKIPPED>
									<MESH_TESTDB_MANAGER_POSTGRES_DB>mesh</MESH_TESTDB_MANAGER_POSTGRES_DB>
									<MESH_TESTDB_MANAGER_POSTGRES_HOST>+${docker.container.postgres.ip}</MESH_TESTDB_MANAGER_POSTGRES_HOST>
									<MESH_TESTDB_MANAGER_POSTGRES_PORT>5432</MESH_TESTDB_MANAGER_POSTGRES_PORT>
									<MESH_TESTDB_MANAGER_POSTGRES_HOST_EXTERNAL>localhost</MESH_TESTDB_MANAGER_POSTGRES_HOST_EXTERNAL>
									<MESH_TESTDB_MANAGER_POSTGRES_PORT_EXTERNAL>+${postgres.port}</MESH_TESTDB_MANAGER_POSTGRES_PORT_EXTERNAL>
									<MESH_TESTDB_MANAGER_POSTGRES_USERNAME>meshdbuser</MESH_TESTDB_MANAGER_POSTGRES_USERNAME>
									<MESH_TESTDB_MANAGER_POSTGRES_PASSWORD><![CDATA[changeitNow4567&]]></MESH_TESTDB_MANAGER_POSTGRES_PASSWORD>
								</env>
								<wait>
									<log>.*WebSocket ready for connections.*</log>
									<time>60000</time>
								</wait>
								<ports>
									<port>8080:8080</port>
								</ports>
							</run>
						</image>
					</images>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
