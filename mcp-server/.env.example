# ──────────────────────────────────────────────────────────────────
# Gentics Mesh MCP Server – Java – Umgebungsvariablen
# Kopieren: cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# ── Pflichtfelder ─────────────────────────────────────────────────
# Basis-URL der Gentics-Mesh-Instanz (ohne abschließenden Slash)
MESH_BASE_URL=http://localhost:8080

# ── Mesh-Authentifizierung: API-Key ODER Username+Passwort ────────
# Variante A (empfohlen für Prod): API-Key aus Mesh (langlebiges JWT).
# Wird als Bearer-Header an jede Anfrage gehängt, kein Login-Roundtrip,
# kein Passwort im Deployment. Hat Vorrang, wenn beides gesetzt ist.
# MESH_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Variante B: Service-Account-Zugangsdaten (nur nötig ohne MESH_API_KEY)
MESH_USERNAME=admin
MESH_PASSWORD=admin

# Kommagetrennte Liste erlaubter Projektnamen
MESH_ALLOWED_PROJECTS=demo

# ── Optionale Einschränkungen ──────────────────────────────────────
# Schema-Allowlist (leer = alle Schemas erlaubt)
# MESH_ALLOWED_SCHEMAS=article,vehicle,category

# Erlaubte Sprachcodes (ISO 639-1)
MESH_ALLOWED_LANGUAGES=de,en

# Read-Only-Modus (true = keine Schreiboperationen, empfohlen)
MESH_READ_ONLY=true

# ── GraphQL-Guardrails ─────────────────────────────────────────────
# Maximale Query-Verschachtelungstiefe (1-20)
MESH_GRAPHQL_MAX_DEPTH=6

# Timeout für GraphQL-Requests in ms (min. 100)
MESH_GRAPHQL_TIMEOUT_MS=5000

# ── Logging ───────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── MCP-Transport ─────────────────────────────────────────────────
# stdio = Claude Desktop / lokale Child-Prozess-Clients (Default)
# http  = Remote-Clients (OpenAI Agents, LangChain, n8n, Open WebUI, …)
MCP_TRANSPORT=stdio

# Bind-Host und -Port für den HTTP-Modus
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3001

# Bearer-Token, das Clients als `Authorization: Bearer <token>` schicken müssen.
# Im HTTP-Modus PFLICHT, außer MCP_AUTH_DISABLED=true ist gesetzt
# (z.B. wenn ein Reverse-Proxy bereits authentifiziert).
# MCP_AUTH_TOKEN=please-change-me

# Nur setzen, wenn Auth bewusst vor dem Server (Ingress/Proxy) terminiert wird.
MCP_AUTH_DISABLED=false

# Kommagetrennte Liste erlaubter Origins für CORS-Anfragen.
# Leer = keine CORS-Header. `*` = alle Origins erlaubt.
# MCP_CORS_ORIGINS=https://app.example.com,https://ai.example.com

# ── Mesh-Schutz: Rate-Limit / Bulkhead / Circuit Breaker ──────────
# Token-Bucket pro Sekunde, global. Gewichtet pro Tool (graphql=5, search=3, …).
MCP_RATE_LIMIT_PER_SECOND=50

# Token-Bucket pro Sekunde, pro Bearer-Token (HTTP-Modus). Stdio ist exempt.
MCP_RATE_LIMIT_PER_TOKEN_PER_SECOND=20

# Maximale gleichzeitige in-flight Mesh-Anfragen (Bulkhead-Permits).
MCP_MESH_MAX_CONCURRENT=10

# Circuit Breaker: schaltet bei häufigen Mesh-Fehlern auf "fail-fast".
MCP_CIRCUIT_BREAKER_ENABLED=true
MCP_CIRCUIT_BREAKER_FAILURE_RATE_PERCENT=50
MCP_CIRCUIT_BREAKER_WINDOW_SIZE=20
MCP_CIRCUIT_BREAKER_OPEN_DURATION_MS=30000

# Maximale Zeichen-Länge einer GraphQL-Query (gegen pathologisch lange Queries).
MCP_GRAPHQL_MAX_QUERY_LENGTH=4000
