// ─────────────────────────────────────────────────────────────────────────────
// mesh-mcp-server – Modul-Pipeline für mesh-enterprise.
//
// Diese Datei sollte im mesh-enterprise-Repo unter mcp-server/Jenkinsfile
// liegen. Sie wird typischerweise aus dem Root-Jenkinsfile von mesh-enterprise
// per `load 'mcp-server/Jenkinsfile'` oder über einen Multibranch-Job referenziert.
//
// Annahmen / TODOs für die finale Integration:
//   * Tool-Names (`jdk17`, `maven3`) müssen mit den im Jenkins konfigurierten
//     Installationen übereinstimmen (Manage Jenkins → Tools).
//   * `repo.gentics.com` Credential-ID `gentics-registry` muss existieren.
//   * Branch-Pattern `release/*` und `main` ggf. an die mesh-enterprise-
//     Branching-Strategie angleichen.
//   * Wenn der Image-Tag nicht aus dem POM, sondern aus einem Mesh-Release-Tag
//     ableitbar sein soll: VERSION-Variable im `env`-Block überschreiben.
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent {
        label 'linux && docker'
    }

    tools {
        jdk   'jdk17'
        maven 'maven3'
    }

    environment {
        REGISTRY      = 'repo.gentics.com'
        IMAGE_NAME    = 'mesh/mcp-server'
        MAVEN_OPTS    = '-Dfile.encoding=UTF-8 -Xmx1g'
    }

    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
    }

    stages {

        stage('Build & Test') {
            steps {
                dir('mcp-server') {
                    sh 'mvn -B -ntp -pl . -am verify'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'mcp-server/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Resolve Version') {
            steps {
                script {
                    // Effektive Modul-Version aus dem POM (geerbt vom Parent).
                    env.VERSION = sh(
                        script: '''
                            cd mcp-server && \
                            mvn -B -ntp -q help:evaluate \
                                -Dexpression=project.version -DforceStdout
                        ''',
                        returnStdout: true
                    ).trim()
                    echo "Resolved module version: ${env.VERSION}"
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('mcp-server') {
                    sh '''
                        docker build \
                          --build-arg VERSION=${VERSION} \
                          -t ${REGISTRY}/${IMAGE_NAME}:${VERSION} \
                          -t ${REGISTRY}/${IMAGE_NAME}:latest \
                          .
                    '''
                }
            }
        }

        stage('Docker Push') {
            when {
                anyOf {
                    branch 'main'
                    branch 'release/*'
                    buildingTag()
                }
            }
            steps {
                withCredentials([usernamePassword(
                        credentialsId: 'gentics-registry',
                        usernameVariable: 'REG_USER',
                        passwordVariable: 'REG_PASS')]) {
                    sh '''
                        echo "$REG_PASS" | docker login ${REGISTRY} -u "$REG_USER" --password-stdin
                        docker push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
                        if [ "$BRANCH_NAME" = "main" ] || [ -n "$TAG_NAME" ]; then
                          docker push ${REGISTRY}/${IMAGE_NAME}:latest
                        fi
                        docker logout ${REGISTRY}
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker image prune -f --filter "label=org.opencontainers.image.title=mesh-mcp-server" || true'
        }
        failure {
            // Hook für Slack/Email-Notifications hier ergänzen, sobald
            // die mesh-enterprise-Notification-Strategie steht.
            echo 'Build failed.'
        }
    }
}
